# ==============================================================================
# SCHOLAR-TRACK ENVIRONMENT VARIABLES (TEMPLATE)
# Copy this file to '.env' inside the 'server' directory or project root.
# IMPORTANT: NEVER commit your actual '.env' file with real credentials!
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (MongoDB Atlas or Local MongoDB)
# Example Atlas format: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/scholar_track?retryWrites=true&w=majority
# Example Local format: mongodb://127.0.0.1:27017/scholar_track
MONGODB_URI=mongodb://127.0.0.1:27017/scholar_track

# Authentication & Security
# Generate a strong 64-character random string (e.g. using `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
JWT_SECRET=your_jwt_secret_key_here_min_32_chars_long
JWT_EXPIRES_IN=7d

# AI Configuration (ScholarBot)
# AI_PROVIDER options: 'gemini', 'openai', 'groq', or 'fallback'
# When set to 'fallback' or when API key is left blank, ScholarBot operates with its
# built-in intelligent Rule & Database Knowledge Engine (100% functional, 0 cost).
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
